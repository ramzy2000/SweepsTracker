@page "/"
@inject NavigationManager navigationManager

<div class="container">
  <img class ="logo" src="./images/home_logo.png"/>
</div>

<div class="button-layout">
  <button @onclick="newGameClicked" class="btn btn-primary" type="button">New Game</button>
  <button @onclick="continueGameClicked" class="btn btn-primary" type="button">Continue Game</button>
  <button class="btn btn-primary" type="button">History</button>
</div>

@code {
  public void newGameClicked()
  {
    navigationManager.NavigateTo("new-game");
  }

  public void continueGameClicked()
  {
    navigationManager.NavigateTo("active-games");
  }
}