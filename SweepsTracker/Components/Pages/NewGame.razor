@page "/new-game"
@using SweepsTracker.Core

@inject SweepsDatabase sweepsDatabase

@inject GameSessionData gameSessionData
@inject NavigationManager navigationManager

@if(currentStep == 1)
{
    <section class="new-game-shell">
        <header class="new-game-header">
            <h1>New Game Setup</h1>
            <p>Add players to begin a new game of sweeps. </p>
        </header>

        <div class="add-player-card">
            <label class="field-label" for="player-name">Player Name</label>
            <div class="input-row">
                <input id="player-name" @bind="name" @bind:event="oninput" @onkeydown="HandleNameInputKeydown"
                       class="form-control" placeholder="Enter a name" maxlength="32" />

                <button class="btn btn-primary add-button" @onclick="AddName" disabled="@string.IsNullOrWhiteSpace(name)">
                    <i class="bi bi-plus-lg"></i>
                    Add
                </button>
            </div>
        </div>

        <div class="players-card">
            <div class="players-card-header">
                <h2>Players</h2>
                <span class="count-pill">@players.Count</span>
            </div>

            @if (players.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <p>No names added yet.</p>
                </div>
            }
            else
            {
                <ul class="player-list" aria-label="Players added to this game">
                    @foreach (Player player in players)
                    {
                        <li class="player-item">
                            <span class="player-name">@player.Name</span>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveName(player)" aria-label="Remove @player">
                                <i class="bi bi-trash"></i>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        <footer class="actions-row">
            <button class="btn btn-primary next-button" @onclick="NextButtonClickedNames"
                    disabled="@(players.Count < 2)">Next</button>
        </footer>
    </section>
}
else if (currentStep == 2)
{
    <section class="new-game-shell">
        <header class="new-game-header">
            <h1>Set Max Score</h1>
            <p>Choose the score needed to win this game.</p>
        </header>

        <div class="players-card setup-review-card">
            <div class="players-card-header">
                <h2>Players Ready</h2>
                <span class="count-pill">@players.Count</span>
            </div>

            <ul class="player-list" aria-label="Players in this game">
                @foreach (Player player in players)
                {
                    <li class="player-item">
                        <span class="player-name">@player.Name</span>
                    </li>
                }
            </ul>
        </div>

        <div class="add-player-card max-score-card">
            <label class="field-label" for="max-score">Max Score</label>
            <input id="max-score" type="number" @bind="maxScore" min="150" max="500" class="form-control score-input"
                   placeholder="Enter max score" />

            @if (!string.IsNullOrWhiteSpace(maxScoreValidationMessage))
            {
                <p class="validation-text">@maxScoreValidationMessage</p>
            }
        </div>

        <footer class="actions-row two-actions">
            <button class="btn btn-outline-light secondary-action" @onclick="BackToPlayersStep">Back</button>
            <button class="btn btn-primary next-button" @onclick="CreateNewGame" disabled="@(!CanCreateGame)">Create New
                Game</button>
            </footer>
        </section>
    }
else
    {
        @if (failedToCreate)
        {
            <section class="new-game-shell">
                <header class="new-game-header">
                    <h1>Failed to create Game</h1>
                </header>
            </section>
        }
        else
        {
            <section class="new-game-shell">
                <header class="new-game-header">
                    <h1>Game Created</h1>
                    <p>Your session is ready to start.</p>
                </header>

                <div class="players-card setup-review-card">
                    <h2 class="created-title">Game Details</h2>

                    <div class="created-detail-row">
                        <span>Players</span>
                        <strong>@players.Count</strong>
                    </div>
                    <div class="created-detail-row">
                        <span>Max Score</span>
                        <strong>@maxScore</strong>
                    </div>

                    <ul class="player-list" aria-label="Final player list">
                        @foreach (Player player in players)
                        {
                            <li class="player-item">
                                <span class="player-name">@player.Name</span>
                            </li>
                        }
                    </ul>
                </div>

                <footer class="actions-row two-actions">
                    <button class="btn btn-outline-light secondary-action" @onclick="StartGame">Start Game</button>
                </footer>
            </section>
        }
    }

@code {

    Game game = new Game();

    List<Player> players = new List<Player>();
    private int currentStep = 1;

    bool failedToCreate = false;

    private string? gameName;

    private string? name;
    private int? maxScore;
    private string? maxScoreValidationMessage;

    private bool CanCreateGame => maxScore.HasValue && maxScore.Value >= 150 && maxScore.Value <= 500;

    private void NextButtonClickedNames()
    {
        if (players.Count >= 2)
        {
            currentStep = 2;
        }
    }

    private void AddName()
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        Player newPlayer = new Player();

        newPlayer.Name = name.Trim();

        bool nameFound = false;
        // check if name is already in the players
        foreach (Player player in players)
        {
            if (player.Name == newPlayer.Name)
            {
                nameFound = true;
            }
        }

        if (!nameFound)
        {
            players.Add(newPlayer);
        }

        name = string.Empty;
    }

    private void RemoveName(Player player)
    {
        players.Remove(player);
    }

    private void HandleNameInputKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            AddName();
        }
    }

    private void BackToPlayersStep()
    {
        currentStep = 1;
        maxScoreValidationMessage = null;
    }

    private async Task CreateNewGame()
    {
        if (!CanCreateGame)
        {
            maxScoreValidationMessage = "Enter a max score between 150 and 500.";
            return;
        }

        

        if (maxScore != null)
        {
            game.MaxScore = (int)maxScore;
        }

        
        currentStep = 3;
        maxScoreValidationMessage = null;
        // create the game in the database
        gameSessionData.currentGameSession = await sweepsDatabase.CreateNewGameAsync(game, players);
        if (gameSessionData.currentGameSession != null)
        {
            game = gameSessionData.currentGameSession;
        }
        else
        {
            failedToCreate = true;
        }
    }

    private void StartGame()
    {
        navigationManager.NavigateTo("/gamesession", replace: true);
    }
}
