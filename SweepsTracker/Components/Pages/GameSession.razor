@page "/gamesession"
@using SweepsTracker.Core
@inject NavigationManager navigationManager
@inject SweepsDatabase sweepsDatabase
@inject GameSessionData gameSessionData

@if (gameInfo != null && shouldDisplayNewRoundDialog == false)
{
    <section>
        <header>
            <div class="box">
                <h1>Game Session</h1>
                <p>Information for the current game session.</p>
            </div>
            <div class="box">
                <h1>Max Score: @gameSessionData.currentGameSession.MaxScore</h1>
            </div>
        </header>
        <div>
            @if (gameInfo.RoundCount > 0)
            {
                @foreach (KeyValuePair<Player, List<int>> entry in gameInfo.Info)
                {
                    roundNumber = 1;
                    <table class="table table-dark table-bordered">
                        <thead>
                            <tr>
                                <th class="center-header" colspan="2">@entry.Key.Name</th>
                            </tr>
                            <tr>
                                <th>Round</th>
                                <th>Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (int score in entry.Value)
                            {
                                <tr>
                                    <th scope="row">@roundNumber</th>
                                    <td>@score</td>
                                </tr>
                                roundNumber++;
                            }
                            <tr class="total table-active">
                                <th>Total Score</th>
                                <th>@entry.Key.TotalScore</th>
                            </tr>
                        </tbody>
                    </table>
                }
            }
            else
            {
                <h1>No Rounds in this game yet</h1>
            }

        </div>
    </section>

    <div>
        <button @onclick="AddNewRoundClickedAsync" class="btn btn-primary">Add New Round</button>
    </div>
}
else if (shouldDisplayNewRoundDialog)
{
    <section>
        <header>
            <h1>Enter New Round Scores</h1>
        </header>

        <div class="score-entry-grid">
            @foreach (Player player in players)
            {
                <div class="score-entry-row">
                    <label class="player-label">@player.Name</label>
                    <input class="input-name score-input" type="number" min="0" required
                           value="@roundScores[player]"
                           @onchange="e => roundScores[player] = int.TryParse(e.Value?.ToString(), out int v) ? v : 0"
                           placeholder="Score">
                </div>
            }
        </div>

        <div class="button-layout">
            <button @onclick="AddRoundAsync" class="btn btn-secondary">Add Round</button>
            <button @onclick="CancelRoundClicked" class="btn btn-secondary">Cancel</button>
        </div>
    </section>
}
else
{
    <h1>No Game Found</h1>
}

@code {
    GameInfo? gameInfo = null;
    int roundNumber = 1;

    bool shouldDisplayNewRoundDialog = false;

    List<Player> players = new List<Player>();
    Dictionary<Player, int> roundScores = new Dictionary<Player, int>();


    private async Task CancelRoundClicked()
    {
        shouldDisplayNewRoundDialog = false;
    }

    private async Task AddNewRoundClickedAsync()
    {
        players = await sweepsDatabase.GetPlayersFromGame(gameSessionData.currentGameSession.ID);
        roundScores = players.ToDictionary(p => p, _ => 0);
        shouldDisplayNewRoundDialog = true;
    }

    private async Task AddRoundAsync()
    {
        await sweepsDatabase.AddRoundScoresAsync(gameSessionData.currentGameSession.ID, roundScores);
        gameInfo = await sweepsDatabase.GetGameInfoAsync(gameSessionData.currentGameSession.ID);
        shouldDisplayNewRoundDialog = false;
    }

    protected override async Task OnInitializedAsync()
    {
        gameInfo = await sweepsDatabase.GetGameInfoAsync(gameSessionData.currentGameSession.ID);
    }
}