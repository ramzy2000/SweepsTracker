@page "/gamesession"
@using SweepsTracker.Core
@inject NavigationManager navigationManager
@inject SweepsDatabase sweepsDatabase
@inject GameSessionData gameSessionData

@if (gameDisplayTable != null && shouldDisplayNewRoundDialog == false)
{
    <section>
        <header>
            <div class="box">
                <h1>Game Session</h1>
                <p>Information for the current game session.</p>
            </div>
            <div class="box">
                <h1>Max Score: @gameSessionData.currentGameSession.MaxScore</h1>
            </div>
        </header>
        <div>
            @if (gameDisplayTable.RoundCount > 0)
            {
                <table class="table table-dark table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            @foreach (string name in gameDisplayTable.names)
                            {
                                <th th scope="col">@name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (List<int> displayScoreRound in gameDisplayTable.displayScores)
                        {
                            <tr>
                                <th scope="row">@roundNumber</th>
                                @foreach (int score in displayScoreRound)
                                {
                                    <td>@score</td>
                                }
                            </tr>
                            roundNumber++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <h1>No Rounds in this game yet</h1>
            }
        </div>
    </section>

    <div>
        <button @onclick="AddNewRoundClickedAsync" class="btn btn-primary">Add New Round</button>
    </div>
}
else if (shouldDisplayNewRoundDialog)
{
    <section>
        <header>
            <h1>Enter new round of scores per player</h1>
        </header>

        <div>
            @foreach (Player player in players)
            {
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text" id="basic-addon3">@player.Name</span>
                        <input type="text" class="form-control" aria-describedby="basic-addon3 basic-addon4">
                    </div>
                </div>
            }

        </div>

        <div class="button-layout">
            <button class="btn btn-primary">Add Round</button>
            <button @onclick="CancelRoundClicked" class="btn btn-primary">Cancel</button>
        </div>
    </section>
}
else
{
    <h1>No Game Found</h1>
}

@code {
    GameDisplayTable? gameDisplayTable = null;
    int roundNumber = 1;

    bool shouldDisplayNewRoundDialog = false;


    List<Player> players = new List<Player>();


    private async Task CancelRoundClicked()
    {
        shouldDisplayNewRoundDialog = false;
    }

    private async Task AddNewRoundClickedAsync()
    {
        players = await sweepsDatabase.GetPlayersFromGame(gameSessionData.currentGameSession.ID);
        shouldDisplayNewRoundDialog = true;
    }

    protected override async Task OnInitializedAsync()
    {
        gameDisplayTable = await sweepsDatabase.GetGameDisplayTable(gameSessionData.currentGameSession.ID);
    }
}