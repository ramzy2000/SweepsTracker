@page "/new-game"

@if (currentStep == 1)
{
    <section class="new-game-shell">
        <header class="new-game-header">
            <h1>New Game Setup</h1>
            <p>Add players to begin a new game of sweeps. </p>
        </header>

        <div class="add-player-card">
            <label class="field-label" for="player-name">Player Name</label>
            <div class="input-row">
                <input
                    id="player-name"
                    @bind="newName"
                    @bind:event="oninput"
                    @onkeydown="HandleNameInputKeydown"
                    class="form-control"
                    placeholder="Enter a name"
                    maxlength="32" />

                <button class="btn btn-primary add-button" @onclick="AddName" disabled="@string.IsNullOrWhiteSpace(newName)">
                    <i class="bi bi-plus-lg"></i>
                    Add
                </button>
            </div>
        </div>

        <div class="players-card">
            <div class="players-card-header">
                <h2>Players</h2>
                <span class="count-pill">@names.Count</span>
            </div>

            @if (names.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <p>No names added yet.</p>
                </div>
            }
            else
            {
                <ul class="player-list" aria-label="Players added to this game">
                    @foreach (var name in names)
                    {
                        <li class="player-item">
                            <span class="player-name">@name</span>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveName(name)" aria-label="Remove @name">
                                <i class="bi bi-trash"></i>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        <footer class="actions-row">
            <button class="btn btn-primary next-button" @onclick="NextButtonClickedNames" disabled="@(names.Count == 0)">Next</button>
        </footer>
    </section>
}
else if (currentStep == 2)
{
    <section class="new-game-shell">
        <header class="new-game-header">
            <h1>Set Max Score</h1>
            <p>Choose the score needed to win this game.</p>
        </header>

        <div class="players-card setup-review-card">
            <div class="players-card-header">
                <h2>Players Ready</h2>
                <span class="count-pill">@names.Count</span>
            </div>

            <ul class="player-list" aria-label="Players in this game">
                @foreach (var name in names)
                {
                    <li class="player-item">
                        <span class="player-name">@name</span>
                    </li>
                }
            </ul>
        </div>

        <div class="add-player-card max-score-card">
            <label class="field-label" for="max-score">Max Score</label>
            <input
                id="max-score"
                type="number"
                @bind="maxScore"
                min="150"
                max="500"
                class="form-control score-input"
                placeholder="Enter max score" />

            @if (!string.IsNullOrWhiteSpace(maxScoreValidationMessage))
            {
                <p class="validation-text">@maxScoreValidationMessage</p>
            }
        </div>

        <footer class="actions-row two-actions">
            <button class="btn btn-outline-light secondary-action" @onclick="BackToPlayersStep">Back</button>
            <button class="btn btn-primary next-button" @onclick="CreateNewGame" disabled="@(!CanCreateGame)">Create New Game</button>
        </footer>
    </section>
}
else
{
    <section class="new-game-shell">
        <header class="new-game-header">
            <h1>Game Created</h1>
            <p>Your session is ready to start.</p>
        </header>

        <div class="players-card setup-review-card">
            <h2 class="created-title">Game Details</h2>

            <div class="created-detail-row">
                <span>Players</span>
                <strong>@names.Count</strong>
            </div>
            <div class="created-detail-row">
                <span>Max Score</span>
                <strong>@maxScore</strong>
            </div>

            <ul class="player-list" aria-label="Final player list">
                @foreach (var name in names)
                {
                    <li class="player-item">
                        <span class="player-name">@name</span>
                    </li>
                }
            </ul>
        </div>

        <footer class="actions-row two-actions">
            <button class="btn btn-outline-light secondary-action" @onclick="StartOver">Start Over</button>
        </footer>
    </section>
}

@code {
    private int currentStep = 1;

    private string? newName;
    private int? maxScore;
    private string? maxScoreValidationMessage;

    private List<string> names = new();

    private bool CanCreateGame => maxScore.HasValue && maxScore.Value >= 150 && maxScore.Value <= 500;

    private void NextButtonClickedNames()
    {
        if (names.Count > 0)
        {
            currentStep = 2;
        }
    }

    private void AddName()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            return;
        }

        var trimmedName = newName.Trim();

        if (!names.Any(existingName => string.Equals(existingName, trimmedName, StringComparison.OrdinalIgnoreCase)))
        {
            names.Add(trimmedName);
        }

        newName = string.Empty;
    }

    private void RemoveName(string name)
    {
        names.Remove(name);
    }

    private void HandleNameInputKeydown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            AddName();
        }
    }

    private void BackToPlayersStep()
    {
        currentStep = 1;
        maxScoreValidationMessage = null;
    }

    private void CreateNewGame()
    {
        if (!CanCreateGame)
        {
            maxScoreValidationMessage = "Enter a max score between 150 and 500.";
            return;
        }

        maxScoreValidationMessage = null;
        currentStep = 3;
    }

    private void StartOver()
    {
        currentStep = 1;
        newName = string.Empty;
        maxScore = null;
        maxScoreValidationMessage = null;
        names.Clear();
    }
}
